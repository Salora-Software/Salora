{
	"name": "salora-monorepo",
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"prettier": "latest",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"prettier-plugin-tailwindcss-canonical-classes": "^0.1.5",
		"tailwindcss": "^4.3.3",
		"turbo": "latest",
		"wrangler": "^4.113.0"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "bun@1.3.5",
	"private": true,
	"scripts": {
		"build": "bun run --env-file=.env turbo run build",
		"build:frontend": "bun run --env-file=.env turbo run build --filter=frontend",
		"build:ci": "turbo run build:worker --filter=frontend",
		"build:email:worker": "bun run --env-file=.env turbo run build:worker --filter=email-worker",
		"deploy": "bun run --env-file=.env turbo run build:worker --filter=frontend && bunx wrangler deploy --env prod",
		"deploy:dev": "bun run --env-file=.env turbo run build:worker --filter=frontend && bunx wrangler deploy --env dev",
		"deploy:ci": "wrangler deploy --env prod",
		"preview": "bun run --env-file=.env turbo run build:worker --filter=frontend && bunx wrangler preview",
		"deploy:email": "bun run --env-file=.env turbo run build:worker --filter=email-worker && cd apps/email-worker && bunx wrangler deploy",
		"dev": "bun run --env-file=.env turbo run dev --filter=frontend",
		"dev:worker": "bun run --env-file=.env turbo run dev:worker",
		"dev:frontend:worker": "bun run --env-file=.env turbo run dev:worker --filter=frontend",
		"db:generate": "bun run --env-file=.env turbo run generate",
		"db:generate:worker": "bun run --env-file=.env turbo run generate:worker",
		"db:push": "bun run --env-file=.env turbo run db:push",
		"db:migrate": "wrangler d1 migrations apply DB --remote --env prod",
		"db:migrate:dev": "wrangler d1 migrations apply DB_DEV --remote --env dev",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"create:package": "bun run scripts/create-package.ts"
	},
	"trustedDependencies": [
		"sharp"
	],
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "^1.0.13",
		"mysql2": "^3.23.1"
	},
	"overrides": {
		"tailwind-merge": "3.5.0"
	}
}
