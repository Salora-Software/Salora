generator client {
    provider = "prisma-client"
    runtime  = "workerd"
    output   = "./generated/prisma-worker"
}

datasource db {
    provider = "sqlite"
}

// ---------- Account and Session ----------

model User {
    id            String        @id
    name          String
    email         String
    emailVerified Boolean
    image         String?
    createdAt     DateTime
    updatedAt     DateTime
    sessions      Session[]
    accounts      Account[]
    fingerprints  Fingerprint[]

    phone String?

    members     Member[]
    invitations Invitation[]
    bookings    Booking[]
    customers   Customer[]
    notes       Note[]

    @@unique([email])
    @@map("user")
}

model Session {
    id        String   @id
    expiresAt DateTime
    token     String
    createdAt DateTime
    updatedAt DateTime
    ipAddress String?
    userAgent String?
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    activeOrganizationId String?

    @@unique([token])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime
    updatedAt             DateTime

    @@map("account")
}

model Fingerprint {
    id            String   @id @default(cuid())
    fingerprintId String   @unique // the actual fingerprint string from JS
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    // Optional: Track known IPs and metadata
    lastSeenAt  DateTime?
    ipAddresses String // list of known IPs

    flagged    Boolean @default(false)
    trustScore Int     @default(0)
    users      User[]

    @@map("fingerprint")
}

model Verification {
    id         String    @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime?
    updatedAt  DateTime?

    @@map("verification")
}

// ----------  Organization settings ----------

model Organization {
    id                    String                 @id
    name                  String
    slug                  String?
    logo                  String?
    createdAt             DateTime
    metadata              String?
    members               Member[]
    maxMembers            Int?
    invitations           Invitation[]
    location              String?
    website               String?
    phone                 String?
    email                 String?
    timeZone              String
    services              Service[]
    packages              Package[]
    bookings              Booking[]
    openingTimes          OpeningTime[]
    customer              Customer[]
    communicationSettings CommunicationSetting[]
    templates             Template[]
    calendarItems         CalendarItem[]
    appointmentStatus     BookingStatus          @default(PENDING)
    minimumBookingTime    Float                  @default(0.5)
    bookingPeriod         Int                    @default(365)
    autoShiftTimeSlot     Boolean                @default(false)
    onboardingStep        Int?                   @default(0)

    @@unique([slug])
    @@map("organization")
}

model OpeningTime {
    id             String       @id @unique @default(uuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    dayOfWeek      Int
    startTimeUtc   DateTime
    endTimeUtc     DateTime
    createdAt      DateTime     @default(now())

    @@map("opening_time")
}

model Member {
    id               String           @id
    organizationId   String
    organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    userId           String
    user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    role             String
    invitationStatus InvitationStatus @default(ACTIVE)
    createdAt        DateTime

    // employee
    services      EmployeeService[]
    availability  Availability[]
    timeOffs      TimeOff[]
    bookings      Booking[]
    calendarItems CalendarItem[]

    @@map("member")
}

model Customer {
    id        String  @id @default(uuid())
    authToken String? @unique

    name           String
    email          String
    phone          String?
    address        String?
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    bookings       Booking[]
    notes          Note[]

    createdAt DateTime @default(now())
    user      User?    @relation(fields: [userId], references: [id])
    userId    String?

    @@unique([email, organizationId])
    @@map("customer")
}

model Invitation {
    id             String       @id
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    email          String
    role           String?
    status         String
    expiresAt      DateTime
    inviterId      String
    user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

    @@map("invitation")
}

// ----------  Booking and Service ----------

model CalendarItem {
    id             String       @id @default(uuid())
    organizationId String
    organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    title          String?

    memberId String?
    member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

    startTime DateTime
    endTime   DateTime
    type      CalendarItemType
    notes     String?

    // One-to-one relations
    booking   Booking? @relation(fields: [bookingId], references: [id])
    bookingId String?  @unique

    timeOff   TimeOff? @relation(fields: [timeOffId], references: [id])
    timeOffId String?  @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("calendar_item")
}

model Service {
    id             String            @id @default(uuid())
    name           String
    description    String?
    sortingIndex   Int               @default(-1)
    duration       Int // Duur in minuten
    price          Float
    organizationId String
    organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    employees      EmployeeService[]
    bookings       Booking[]
    packages       PackageService[]
    visible        Boolean?          @default(true)

    @@map("service")
}

model EmployeeService {
    id        String  @id @default(uuid())
    memberId  String
    member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
    serviceId String
    service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    @@unique([memberId, serviceId])
    @@map("employee_service")
}

model TimeOff {
    id           String        @id
    memberId     String
    member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
    reason       String?
    type         TimeOffType
    calendarItem CalendarItem?

    @@map("time_off")
}

model Availability {
    id           String   @id
    memberId     String
    member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
    dayOfWeek    Int // 0 = zondag, 6 = zaterdag
    startTimeUtc DateTime
    endTimeUtc   DateTime

    @@map("availability")
}

model Booking {
    id             String  @id @default(cuid())
    serviceId      String
    employeeId     String?
    organizationId String
    userId         String?
    customerId     String?

    service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    employee     Member?       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
    organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    User         User?         @relation(fields: [userId], references: [id])
    customer     Customer?     @relation(fields: [customerId], references: [id])
    calendarItem CalendarItem?

    createdAt DateTime      @default(now())
    duration  Int
    notes     String?
    status    BookingStatus

    @@map("booking")
}

// Communication settings

model CommunicationSetting {
    id             String            @id @default(uuid())
    organizationId String
    organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    settings       Json // Store transactional settings as a JSON object
    type           CommunicationType
    enabled        Boolean           @default(true)
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt

    @@unique([type, organizationId])
    @@map("communication_setting")
}

model Template {
    id             String         @id @default(uuid())
    organizationId String
    organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    type           TemplateType
    target         TemplateTarget
    subject        String?
    body           String
    enabled        Boolean        @default(true)
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    @@unique([type, target, organizationId])
    @@map("template")
}

model Package {
    id             String           @id @default(uuid())
    name           String
    description    String?
    sortingIndex   Int              @default(-1)
    price          Float
    organizationId String
    organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    services       PackageService[]
    visible        Boolean?         @default(true)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt

    @@map("package")
}

model PackageService {
    id        String  @id @default(uuid())
    packageId String
    package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
    serviceId String
    service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    @@unique([packageId, serviceId])
    @@map("package_service")
}

model Note {
    id         String   @id @default(uuid())
    content    String
    customerId String
    customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
    authorId   String
    author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@map("note")
}

enum CalendarItemType {
    AVAILABILITY
    TIME_OFF
    BOOKING
    NOTE
}

enum TemplateTarget {
    CUSTOMER
    EMPLOYEE
}

enum TemplateType {
    EMAIL_APPROVED
    EMAIL_DENIED
    EMAIL_CANCELED
    EMAIL_CREATED
    SMS_APPROVED
    SMS_DENIED
    SMS_CANCELED
}

enum CommunicationType {
    EMAIL
    SMS
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
    COMPLETED
}

enum TimeOffType {
    LEAVE
    SPECIAL
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    DECLINED
    ACTIVE
}
