{
	"name": "lumabooking-monorepo",
	"devDependencies": {
		"@cloudflare/wrangler": "^1.21.0",
		"@types/bun": "^1.3.8",
		"prettier": "latest",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"prettier-plugin-tailwindcss-canonical-classes": "^0.1.3",
		"tailwindcss": "^4.1.18",
		"turbo": "latest"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "bun@1.3.5",
	"private": true,
	"scripts": {
		"build": "bun run --env-file=.env turbo run build",
		"build:docker": "bun i && bun run --env-file=.env turbo run build:docker --filter=frontend",
		"build:frontend": "bun i && bun run --env-file=.env turbo run build --filter=frontend",
		"build:frontend:worker": "bun i && bun run --env-file=.env turbo run build:worker --filter=frontend",
		"deploy:frontend": "cd apps/frontend && bunx wrangler deploy",
		"deploy:frontend:worker": "bun run build:frontend:worker && cd apps/frontend && bunx wrangler deploy",
		"dev": "bun run --env-file=.env turbo dev",
		"deploy": "bun run --env-file=.env.landing turbo run deploy --filter=landing",
		"db:generate": "bun run --env-file=.env turbo run generate",
		"db:generate:worker": "bun run --env-file=.env turbo run generate:worker",
		"db:push": "bun run --env-file=.env turbo run db:push",
		"services:up": "docker compose up -d",
		"services:stop": "docker compose stop",
		"services:down": "docker compose down",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"create:package": "bun run scripts/create-package.ts"
	},
	"trustedDependencies": [
		"sharp"
	],
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "^1.0.13"
	},
	"overrides": {
		"tailwind-merge": "3.5.0"
	}
}