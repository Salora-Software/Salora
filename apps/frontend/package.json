		"svelte-tiny-slider": "^2.0.0",
		"trpc-panel": "^1.3.4",
		"trpc-svelte-query": "^3.0.3",
		"trpc-svelte-query-adapter": "^2.3.16",
		"vite-plugin-javascript-obfuscator": "^3.1.0",
		"zod": "^3.25.76"
	}
}
