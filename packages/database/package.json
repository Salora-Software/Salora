{
  "name": "@salora/database",
  "version": "0.0.1",
  "main": "./index.ts",
  "types": "./index.ts",
  "type": "module",
  "scripts": {
    "db:push": "bun run prisma db push",
    "db:studio": "bun run prisma studio",
    "db:generate": "bun run prisma generate",
    "services:up": "docker compose -f ../../docker-compose.yml up -d postgres redis",
    "services:stop": "docker compose -f ../../docker-compose.yml stop",
    "services:down": "docker compose -f ../../docker-compose.yml down",
    "generate": "bun run prisma generate",
    "migrate": "bun run prisma migrate dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "dotenv": "^17.2.4",
    "prisma": "7",
    "tsx": "^4.21.0",
    "typescript": "latest"
  }
}
