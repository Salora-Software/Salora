{
  //   "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salora",
  "account_id": "87c967818bd79635480bbb45d9bf3269",
  "main": "apps/frontend/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-03-20",
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "apps/frontend/.svelte-kit/cloudflare",
    // API requests never resolve to a static asset, skip the asset lookup.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 200,
  },
  // ----------------------------------------------------
  // NAMED ENVIRONMENTS (deploy with `--env <name>`)
  // Secrets (BETTER_AUTH_SECRET, SMTP creds) are set with
  // `wrangler secret put <NAME> --env <name>` and are NOT stored here.
  //
  // Database safety: the backend picks the D1 binding from NODE_ENV.
  //   NODE_ENV=production  -> env.DB      (prod database)
  //   NODE_ENV=development -> env.DB_DEV  (dev database)
  // Production only binds DB; dev/previews only bind DB_DEV, so a
  // misconfigured dev Worker fails loudly instead of touching prod data.
  // ----------------------------------------------------
  "env": {
    "prod": {
      "name": "salora-frontend",
      "vars": {
        "DEPLOY_TARGET": "worker",
        "SKIP_DEPENDENCY_INSTALL": "true",
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "PUBLIC_FRONTEND_URL": "https://app.salora.app",
        "PUBLIC_CDN_URL": "https://cdn.salora.app",
        "MAIL_FALLBACK_SERVER": "example.smtp.com",
        "MAIL_FALLBACK_PORT": "587",
        "MAIL_FALLBACK_USERNAME": "usernam",
        "MAIL_FALLBACK_PASSWORD": "password",
        "MAIL_EMAIL_SENDER": "noreply@example.com",
        "TRUSTED_IPS": "https://app.salora.app",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "packages/database/drizzle",
          //   "database_name": "salora-frontend",
          //   "database_id": "e948003e-f342-4674-a065-4c47c48174ef", old
          "database_name": "salora-migrate-test",
          "database_id": "8d216c04-0f72-4f32-a614-2302798af42c",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "email-jobs",
          },
        ],
      },
    },
    "dev": {
      "name": "salora-dev",
      "vars": {
        "DEPLOY_TARGET": "worker",
        "SKIP_DEPENDENCY_INSTALL": "true",
        "NODE_ENV": "development",
        "LOG_LEVEL": "debug",
        "PUBLIC_FRONTEND_URL": "https://dev.salora.app",
        "PUBLIC_CDN_URL": "https://cdn.salora.app",
        "MAIL_FALLBACK_SERVER": "example.smtp.com",
        "MAIL_FALLBACK_PORT": "587",
        "MAIL_FALLBACK_USERNAME": "usernam",
        "MAIL_FALLBACK_PASSWORD": "password",
        "MAIL_EMAIL_SENDER": "noreply@example.com",
        "TRUSTED_IPS": "https://dev.salora.app,http://localhost:5173",
      },
      "d1_databases": [
        {
          // NODE_ENV=development -> getDbBinding() reads DB_DEV
          "binding": "DB_DEV",
          "migrations_dir": "packages/database/drizzle",
          "database_name": "salora-db-dev",
          "database_id": "89f7d5a4-fa43-4c2a-9ba1-9ce071926089",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "email-jobs",
          },
        ],
      },
    },
  },
  // ----------------------------------------------------
  // PREVIEWS (Cloudflare Worker preview deployments)
  // Previews are versions of the top-level worker and use the dev
  // bindings below, so a preview never touches the production DB.
  // `wrangler versions upload` / the Cloudflare dashboard use this block.
  // ----------------------------------------------------
  "previews": {
    "vars": {
      "DEPLOY_TARGET": "worker",
      "SKIP_DEPENDENCY_INSTALL": "true",
      "NODE_ENV": "development",
      "LOG_LEVEL": "debug",
      "PUBLIC_FRONTEND_URL": "https://dev.salora.app",
      "PUBLIC_CDN_URL": "https://cdn.salora.app",
      "MAIL_FALLBACK_SERVER": "example.smtp.com",
      "MAIL_FALLBACK_PORT": "587",
      "MAIL_FALLBACK_USERNAME": "usernam",
      "MAIL_FALLBACK_PASSWORD": "password",
      "MAIL_EMAIL_SENDER": "noreply@example.com",
      // `*.workers.dev` so better-auth accepts the generated preview origin.
      "TRUSTED_IPS": "https://dev.salora.app,http://localhost:5173,https://*.workers.dev",
    },
    "d1_databases": [
      {
        "binding": "DB_DEV",
        "migrations_dir": "packages/database/drizzle",
        "database_name": "salora-db-dev",
        "database_id": "89f7d5a4-fa43-4c2a-9ba1-9ce071926089",
      },
    ],
    "observability": {
      "logs": {
        "enabled": true,
        "invocation_logs": true,
      },
      "traces": {
        "enabled": true,
      },
    },
    "queues": {
      "producers": [
        {
          "binding": "EMAIL_QUEUE",
          "queue": "email-jobs",
        },
      ],
    },
  },
}
