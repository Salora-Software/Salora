{
	"name": "widgets",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "PORT=5173 node ./build",
		"start:docker": "PORT=5173 node ./build",
		"dev": "bunx --bun vite dev --host --port 5174",
		"dev:worker": "DEPLOY_TARGET=worker bun run dev",
		"build": "bunx --bun vite build",
		"build:docker": "DEPLOY_TARGET=docker bunx --bun vite build",
		"build:worker": "DEPLOY_TARGET=worker bunx --bun vite build",
		"build:embed": "vite build -c vite.embed.config.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.561.0",
		"@salora/database": "workspace:*",
		"@salora/eslint-config": "workspace:*",
		"@salora/shared-types": "workspace:*",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.3.5",
		"@types/luxon": "^3.7.6",
		"clsx": "^2.1.1",
		"eslint": "^9.39.5",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.6",
		"wrangler": "^4.168.0"
	},
	"dependencies": {
		"@lottiefiles/dotlottie-svelte": "^0.6.4",
		"@orpc/client": "^1.16.6",
		"@sveltejs/adapter-cloudflare-workers": "^2.9.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@trpc/client": "^11.32.0",
		"@trpc/server": "^11.32.0",
		"bits-ui": "^2.22.0",
		"lucide-svelte": "^0.525.0",
		"luxon": "^3.7.2",
		"rollup-plugin-visualizer": "^7.3.0",
		"superjson": "^2.2.7",
		"svelte-confetti": "^2.3.2",
		"tailwind": "^4.0.0",
		"tailwindcss": "^4.3.5"
	}
}
