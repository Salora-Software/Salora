{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"dashboard": {
		"hello": "Hello {name}",
		"appointment-trends": "Appointment trends",
		"customer-types": "Customer types",
		"percentage-change": [
			{
				"declarations": ["input percentage", "input period", "input trend"],
				"selectors": ["percentage", "period"],
				"match": {
					"percentage=*, period=*": "{percentage}% change compared to previous {period}"
				}
			}
		],
		"summary": "You have {appointments} appointments and {customers} customers during this period."
	},
	"general": {
		"appointments": "Appointments",
		"revenue": "Revenue",
		"customers": "Customers",
		"new-customers": "New customers",
		"last_days": ""
	}
}
