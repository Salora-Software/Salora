{
	"$schema": "https://turbo.build/schema.json",
	"globalEnv": [
		"ACCESS_KEY_ID",
		"ACCOUNT_ID",
		"BETTER_AUTH_SECRET",
		"DATABASE_URL",
		"DEPLOY_TARGET",
		"EMAIL_REDIS_HOST",
		"EMAIL_REDIS_PASSWORD",
		"EMAIL_REDIS_PORT",
		"EMAIL_REDIS_USERNAME",
		"MAIL_EMAIL_SENDER",
		"MAIL_FALLBACK_PASSWORD",
		"MAIL_FALLBACK_PORT",
		"MAIL_FALLBACK_SERVER",
		"MAIL_FALLBACK_USERNAME",
		"PORT",
		"PUBLIC_CDN_URL",
		"PUBLIC_FRONTEND_URL",
		"REDIS_HOST",
		"REDIS_PASSWORD",
		"REDIS_PORT",
		"REDIS_USERNAME",
		"S3_BUCKET",
		"SECRET_ACCESS_KEY",
		"TRUSTED_IPS",
		"TURNSTILE_SECRET_KEY",
		"PUBLIC_DEMO_ORGANIZATION_ID",
		"PUBLIC_DEMO_WIDGET_URL"
	],
	"tasks": {
		"build": {
			"cache": false,
			"dependsOn": [
				"^db:generate",
				"^build"
			],
			"outputs": [
				"dist/**",
				".svelte-kit/**",
				"build/**"
			]
		},
		"build:embed": {
			"cache": false,
			"dependsOn": [
				"^build:embed"
			],
			"outputs": [
				"dist/**",
				".svelte-kit/**",
				"build/**"
			]
		},
		"build:worker": {
			"cache": false,
			"dependsOn": [
				"^build:worker"
			],
			"outputs": [
				"dist/**",
				".svelte-kit/**",
				"build/**"
			]
		},
		"check": {},
		"db:generate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		},
		"db:worker:apply:local": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": [
				"^db:worker:apply:local"
			]
		},
		"dev:worker": {
			"cache": false,
			"persistent": true,
			"dependsOn": [
				"^db:worker:apply:local"
			]
		},
		"frontend#dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": [
				"^db:worker:apply:local"
			],
			"with": [
				"email-worker#dev:worker"
			]
		},
		"lint": {},
		"services:up": {
			"cache": false
		},
		"start": {
			"cache": false,
			"persistent": true
		}
	}
}