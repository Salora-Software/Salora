{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev --host",
		"dev:worker": "DEPLOY_TARGET=worker bunx --bun vite dev --host",
		"start": "PORT=5173 node ./build",
		"start:docker": "PORT=5173 node ./build",
		"build": "bunx vite build",
		"build:worker": "DEPLOY_TARGET=worker bunx vite build",
		"build:docker": "DEPLOY_TARGET=docker bunx vite build",
		"deploy": "wrangler deploy",
		"buildWidget": "vite build --config vite.widget.config.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"pushPackages": "cp -r /root/lumabooking/frontend/packages/fingerprint /root/security/packages",
		"import-customers": "node dumyData/addDummy.js --import",
		"delete-dummy-data": "node dumyData/addDummy.js --delete",
		"remove-duplicates": "node dumyData/addDummy.js --remove-duplicates",
		"show-duplicates": "node dumyData/addDummy.js --show-duplicates",
		"generate-emails": "node dumyData/addDummy.js --generate-emails",
		"docker:push": "docker push ghcr.io/hexidevs/lumabooking:salora && docker push ghcr.io/hexidevs/lumabooking:latest"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.25.0",
		"@salora/eslint-config": "workspace:*",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
