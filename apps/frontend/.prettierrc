{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": [
		"prettier-plugin-svelte",
		"prettier-plugin-tailwindcss-canonical-classes",
		"prettier-plugin-tailwindcss"
	],
	"tailwindcssCanonicalStylesheet": "./src/app.css",
	"tailwindcssCanonicalRootFontSize": 16,
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}