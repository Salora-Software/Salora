		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/luxon": "^3.7.0",
		"apexcharts": "^4.7.0",
		"aws-sdk": "^2.1692.0",
		"better-auth": "1.3.7",
		"bullmq": "^5.56.8",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"i": "^0.3.7",
