{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"$app/types": ["./.svelte-kit/types/index.d.ts"],
			"@/*": ["../backend/src/*"],
			"@backend/*": ["../backend/src/*"]
		},
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		"noEmit": false
	},
	"exclude": [
		"node_modules",
		".svelte-kit/output",
		".svelte-kit/cloudflare",
		".svelte-kit/cloudflare-tmp",
		"src/service-worker.ts",
		"src/service-worker/**"
	]
}
