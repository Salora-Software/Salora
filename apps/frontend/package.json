		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"prettier-plugin-tailwindcss-canonical-classes": "^0.1.5",
		"svelte": "^5.56.7",
