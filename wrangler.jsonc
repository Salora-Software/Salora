{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salora-frontend",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-03-20",
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "../../packages/database/drizzle",
      "database_name": "salora-frontend",
      "database_id": "e948003e-f342-4674-a065-4c47c48174ef",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "email-jobs",
      },
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 200,
  },
  "vars": {
    "DEPLOY_TARGET": "worker",
    "SKIP_DEPENDENCY_INSTALL": "true",
    "PUBLIC_CDN_URL": "https://cdn.salora.app",
    "MAIL_FALLBACK_SERVER": "example.smtp.com",
    "MAIL_FALLBACK_PORT": "587",
    "MAIL_FALLBACK_USERNAME": "usernam",
    "MAIL_FALLBACK_PASSWORD": "password",
    "MAIL_EMAIL_SENDER": "noreply@example.com",
    "TRUSTED_IPS": "",
    "PUBLIC_FRONTEND_URL": "http://localhost:5173",
  },
  "env": {
    "dev": {
      "name": "salora-frontend-dev", // Aparte Worker in Cloudflare Dashboard
      "vars": {
        "PUBLIC_FRONTEND_URL": "https://dev.salora.app",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "../../packages/database/drizzle",
          "database_name": "salora-frontend-dev",
          "database_id": "JOUW_DEV_D1_DATABASE_ID",
        },
      ],
    },
  },
}
