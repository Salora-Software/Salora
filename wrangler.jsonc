{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salora-frontend",
  "main": "apps/backend/src/index.ts",
  "compatibility_date": "2026-03-20",
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  //   "assets": {
  //     "binding": "ASSETS",
  //     "directory": "apps/frontend/.svelte-kit/cloudflare",
  //   },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "packages/database/drizzle",
      "database_name": "salora-frontend",
      "database_id": "e948003e-f342-4674-a065-4c47c48174ef",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "email-jobs",
      },
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "limits": {
    "cpu_ms": 200,
  },
  "vars": {
    "DEPLOY_TARGET": "worker",
    "SKIP_DEPENDENCY_INSTALL": "true",
    "PUBLIC_CDN_URL": "https://cdn.salora.app",
    "MAIL_FALLBACK_SERVER": "example.smtp.com",
    "MAIL_FALLBACK_PORT": "587",
    "MAIL_FALLBACK_USERNAME": "usernam",
    "MAIL_FALLBACK_PASSWORD": "password",
    "MAIL_EMAIL_SENDER": "noreply@example.com",
    "TRUSTED_IPS": "app.salora.app",
  },

  "env": {
    "development": {
      "name": "salora-dev", // Aparte Worker in Cloudflare Dashboard
      "vars": {
        "PUBLIC_FRONTEND_URL": "https://dev.salora.app",
        "DEPLOY_TARGET": "worker",
        "SKIP_DEPENDENCY_INSTALL": "true",
        "PUBLIC_CDN_URL": "https://cdn.salora.app",
        "MAIL_FALLBACK_SERVER": "example.smtp.com",
        "MAIL_FALLBACK_PORT": "587",
        "MAIL_FALLBACK_USERNAME": "usernam",
        "MAIL_FALLBACK_PASSWORD": "password",
        "MAIL_EMAIL_SENDER": "noreply@example.com",
        "TRUSTED_IPS": "https://dev.salora.app,http://localhost:5173",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "migrations_dir": "packages/database/drizzle",
          "database_name": "salora-db-dev",
          "database_id": "89f7d5a4-fa43-4c2a-9ba1-9ce071926089",
        },
      ],
    },
  },
}
